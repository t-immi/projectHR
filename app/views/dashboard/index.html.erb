<% content_for :title, t("dashboard.title") %>

<div class="row mb-4">
  <div class="col-12">
    <h1 class="h2 mb-1"><%= t("dashboard.title") %></h1>
    <p class="text-muted"><%= t("app.tagline") %></p>
  </div>
</div>

<div class="row g-3 mb-4">
  <div class="col-md-4">
    <div class="card shadow-sm h-100">
      <div class="card-body">
        <h2 class="h6 text-muted"><%= t("dashboard.stats.resumes") %></h2>
        <p class="display-6 mb-0"><%= @resumes_count %></p>
      </div>
    </div>
  </div>
  <div class="col-md-4">
    <div class="card shadow-sm h-100">
      <div class="card-body">
        <h2 class="h6 text-muted"><%= t("dashboard.stats.vacancies") %></h2>
        <p class="display-6 mb-0"><%= @vacancies_count %></p>
      </div>
    </div>
  </div>
  <div class="col-md-4">
    <div class="card shadow-sm h-100">
      <div class="card-body">
        <h2 class="h6 text-muted"><%= t("dashboard.stats.match_scores") %></h2>
        <p class="display-6 mb-0"><%= @match_scores_count %></p>
      </div>
    </div>
  </div>
</div>

<div class="row g-4">
  <div class="col-lg-6">
    <div class="card shadow-sm">
      <div class="card-header d-flex justify-content-between align-items-center">
        <span><%= t("dashboard.recent_matches") %></span>
        <%= link_to t("nav.match_scores"), match_scores_path, class: "btn btn-sm btn-outline-primary" %>
      </div>
      <div class="card-body p-0">
        <% if @recent_match_scores.any? %>
          <div class="table-responsive">
            <table class="table table-hover mb-0">
              <thead>
                <tr>
                  <th><%= t("match_scores.index.resume") %></th>
                  <th><%= t("match_scores.index.vacancy") %></th>
                  <th><%= t("match_scores.index.score") %></th>
                </tr>
              </thead>
              <tbody>
                <% @recent_match_scores.each do |match_score| %>
                  <tr>
                    <td><%= link_to match_score.resume.title, match_score.resume %></td>
                    <td><%= link_to match_score.vacancy.title, match_score.vacancy %></td>
                    <td><%= match_score_badge(match_score) %></td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        <% else %>
          <p class="text-muted p-3 mb-0"><%= t("match_scores.index.empty") %></p>
        <% end %>
      </div>
    </div>
  </div>

  <div class="col-lg-6">
    <div class="card shadow-sm mb-4">
      <div class="card-header d-flex justify-content-between align-items-center">
        <span><%= t("dashboard.recent_vacancies") %></span>
        <%= link_to t("vacancies.index.new"), new_vacancy_path, class: "btn btn-sm btn-primary" %>
      </div>
      <ul class="list-group list-group-flush">
        <% @recent_vacancies.each do |vacancy| %>
          <li class="list-group-item d-flex justify-content-between">
            <%= link_to vacancy.title, vacancy %>
            <small class="text-muted"><%= l(vacancy.created_at, format: :short) %></small>
          </li>
        <% end %>
        <% if @recent_vacancies.empty? %>
          <li class="list-group-item text-muted"><%= t("vacancies.index.empty") %></li>
        <% end %>
      </ul>
    </div>

    <div class="card shadow-sm">
      <div class="card-header d-flex justify-content-between align-items-center">
        <span><%= t("dashboard.recent_resumes") %></span>
        <%= link_to t("resumes.index.new"), new_resume_path, class: "btn btn-sm btn-primary" %>
      </div>
      <ul class="list-group list-group-flush">
        <% @recent_resumes.each do |resume| %>
          <li class="list-group-item d-flex justify-content-between">
            <%= link_to resume.title, resume %>
            <small class="text-muted"><%= l(resume.created_at, format: :short) %></small>
          </li>
        <% end %>
        <% if @recent_resumes.empty? %>
          <li class="list-group-item text-muted"><%= t("resumes.index.empty") %></li>
        <% end %>
      </ul>
    </div>
  </div>
</div>
